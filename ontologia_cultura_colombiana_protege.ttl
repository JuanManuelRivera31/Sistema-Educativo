:Etnia a owl:Class .

:Lugar a owl:Class .

:Tema a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :TemaCategoria ;
            owl:onProperty :temaTieneCategoria ] .

:Recurso a owl:Class .

:Persona a owl:Class ;
    rdfs:label "Persona" .

:PublicacionTacita a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Tema ;
            owl:onProperty :publicacion_Tiene_Tema ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Persona ;
            owl:onProperty :publicadoPor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

